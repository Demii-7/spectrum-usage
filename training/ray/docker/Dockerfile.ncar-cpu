# Native x86_64 CPU workers joining the ARM NCAR head. Python/Ray must match.
FROM ubuntu:24.04
RUN test "$(uname -m)" = x86_64 \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       python3 python3-venv python3-pip curl ca-certificates libgomp1 libgl1 \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN python -m pip install --no-cache-dir torch==2.6.0 torchvision==0.21.0 \
      --index-url https://download.pytorch.org/whl/cpu
COPY training/ray/requirements/core.txt /tmp/core-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/core-requirements.txt cloudpickle==3.1.2 \
    && rm /tmp/core-requirements.txt \
    && python -c "import sys,platform,ray,torch,torchvision,numpy; assert platform.machine() == 'x86_64'; assert sys.version_info[:3] == (3,12,3); assert ray.__version__ == '2.54.0'; assert torch.__version__ == '2.6.0+cpu'; assert torch.version.cuda is None; assert numpy.__version__ == '2.1.3'"
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    RAY_USAGE_STATS_ENABLED=0 \
    RAY_LOG_TO_STDERR=1
WORKDIR /workspace/spectrum-usage
COPY training/ray/docker/entrypoint-worker.sh /usr/local/bin/ray-worker
COPY training/ray/docker/load-storage-env.sh /usr/local/bin/load-storage-env.sh
RUN chmod 0755 /usr/local/bin/ray-worker
ENTRYPOINT ["/usr/local/bin/ray-worker"]
