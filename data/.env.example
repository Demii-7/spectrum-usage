# Copy real object-store credentials here before launching sync_object_storage.py.
# Existing shell environment variables override values in this file.

AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>

# Required for S3-compatible object storage. Leave empty for AWS S3.
S3_ENDPOINT_URL=https://chi.tacc.chameleoncloud.org:7480

# Optional, depending on your provider.
AWS_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# Swift / Keystone v3 (REQUIRED for Chameleon application credentials)
# ---------------------------------------------------------------------------
# The AWS_* variables above drive the S3 path used by data/sync_object_storage.py
# (fsspec/s3fs). That path only works with real S3/EC2-style keys from the Ceph
# RGW gateway.
#
# A Chameleon *application credential* (32-hex id + 86-char secret, issued from
# the Horizon dashboard under Identity -> Application Credentials) is NOT an S3
# key. Presenting one to the S3 endpoint returns 403 InvalidAccessKeyId at both
# chi.tacc and chi.uc, port 7480. It authenticates to Keystone v3 on port 5000
# and must be used over the Swift API instead -- i.e. with rclone, not boto3:
#
#   export RCLONE_CONFIG_CHI_TYPE=swift
#   export RCLONE_CONFIG_CHI_AUTH_VERSION=3
#   export RCLONE_CONFIG_CHI_AUTH=https://chi.tacc.chameleoncloud.org:5000/v3
#   export RCLONE_CONFIG_CHI_APPLICATION_CREDENTIAL_ID=<32-hex id>
#   export RCLONE_CONFIG_CHI_APPLICATION_CREDENTIAL_SECRET=<86-char secret>
#   rclone lsf chi:spectrum/checkpoints --ignore-checksum
#
# --ignore-checksum is required: Swift reports a multipart manifest ETag that
# does not equal the whole-object MD5, which rclone otherwise reports as corruption.
OS_AUTH_URL=https://chi.tacc.chameleoncloud.org:5000/v3
OS_APPLICATION_CREDENTIAL_ID=
OS_APPLICATION_CREDENTIAL_SECRET=
